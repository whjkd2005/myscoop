{
    "version": "1.38.3",
    "description": "Reasonix desktop application for DeepSeek Reasoning",
    "homepage": "https://github.com/Linearl/DeepSeek-Reasonix",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Linearl/DeepSeek-Reasonix/releases/download/desktop-v1.38.3-20261012-0045/Reasonix-windows-amd64.zip",
            "hash": ""
        }
    },
    "bin": "Reasonix.exe",
    "shortcuts": [
        [
            "Reasonix.exe",
            "Reasonix"
        ]
    ],
"persist": [
    "reasonix"
],
"post_install": [
    "$target = \"$env:APPDATA\\reasonix\"",
    "$persist = \"$persist_dir\\reasonix\"",
    "if (!(Test-Path $persist)) { New-Item -ItemType Directory -Path $persist -Force | Out-Null }",
    "if (Test-Path $target) { Copy-Item \"$target\\*\" $persist -Recurse -Force; Remove-Item $target -Recurse -Force }",
    "if (!(Test-Path $target)) { New-Item -ItemType Junction -Path $target -Target $persist | Out-Null }",
    "if (!(Test-Path \"$persist\\config.toml\")) { New-Item \"$persist\\config.toml\" -ItemType File -Force | Out-Null }"
],
    "checkver": {
        "github": "https://github.com/Linearl/DeepSeek-Reasonix"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Linearl/DeepSeek-Reasonix/releases/download/desktop-v$version-20261012-0045/Reasonix-windows-amd64.zip"
            }
        }
    }
}
