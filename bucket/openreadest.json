{
    "version": "0.9.100",
    "description": "OpenReadest ebook reader",
    "homepage": "https://github.com/luyishui/OpenReadest",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/luyishui/OpenReadest/releases/download/v0.9.100/OpenReadest_0.9.100_x64-setup.exe",
            "hash": ""
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\" -Recurse -Filter openreadest.exe | ForEach-Object { Copy-Item $_.FullName \"$dir\\OpenReadest.exe\" -Force }",
        "Get-ChildItem \"$dir\" -Recurse -Filter openreadest_thumbnail.dll | ForEach-Object { Copy-Item $_.FullName \"$dir\\openreadest_thumbnail.dll\" -Force }",
        "Remove-Item \"$dir\\OpenReadest_0.9.100_x64-setup.exe\" -Force",
        "Remove-Item \"$dir\\uninstall.exe\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\[NSIS].nsi\" -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "OpenReadest.exe",
    "shortcuts": [
        [
            "OpenReadest.exe",
            "OpenReadest"
        ]
    ],
    "checkver": {
        "github": "luyishui/OpenReadest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/luyishui/OpenReadest/releases/download/v$version/OpenReadest_$version_x64-setup.exe"
            }
        }
    }
}
