{
    "version": "1.1.0",
    "description": "一款简洁而精致的多平台桌面音乐播放器",
    "homepage": "https://github.com/SPlayer-Dev/SPlayer-Next",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SPlayer-Dev/SPlayer-Next/releases/download/v1.1.0/SPlayer-Next-1.1.0-x64-portable.exe"
        }
    },
    "pre_install": [
        "$pluginDir = Join-Path $dir '$PLUGINSDIR'",
        "$innerArchive = Join-Path $pluginDir 'app-64.7z'",
        "",
        "# 如果 Scoop 没有自动展开 NSIS 文件，则先手动展开",
        "if (!(Test-Path $innerArchive)) {",
        "    $tempDir = Join-Path $dir '_nsis'",
        "    New-Item -ItemType Directory -Path $tempDir -Force | Out-Null",
        "    Expand-7ZipArchive -Path $fname -DestinationPath $tempDir",
        "    $pluginDir = Join-Path $tempDir '$PLUGINSDIR'",
        "    $innerArchive = Join-Path $pluginDir 'app-64.7z'",
        "}",
        "",
        "if (!(Test-Path $innerArchive)) {",
        "    throw 'SPlayer-Next: app-64.7z not found in NSIS package.'",
        "}",
        "",
        "# 解开真正的应用程序文件",
        "Expand-7ZipArchive -Path $innerArchive -DestinationPath $dir",
        "",
        "# 清理 NSIS 临时文件",
        "Remove-Item -LiteralPath (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $dir '_nsis') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath $fname -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "SPlayer-Next.exe",
    "shortcuts": [
        [
            "SPlayer-Next.exe",
            "SPlayer-Next"
        ]
    ],
    "checkver": {
        "github": "https://github.com/SPlayer-Dev/SPlayer-Next"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SPlayer-Dev/SPlayer-Next/releases/download/v$version/SPlayer-Next-$version-x64-portable.exe"
            }
        }
    }
}
