{
    "version": "0.1.7",
    "description": "OMP Studio - Oh My Pi Studio (desktop console for oh-my-pi)",
    "homepage": "https://github.com/the-snowpear/omp-studio",
    "license": "MIT",
    "depends": "7zip",
    "architecture": {
        "64bit": {
            "url": "https://github.com/the-snowpear/omp-studio/releases/download/v0.1.7/OMP-Studio-Setup-0.1.7-windows-x64.exe",
            "hash": ""
        }
    },
    "installer": {
        "script": [
            "$tmp = Join-Path $dir 'tmp'",
            "New-Item -ItemType Directory -Force -Path $tmp | Out-Null",
            "$setup = if ($fname) { Join-Path $dir $fname } else { Join-Path $dir \"OMP-Studio-Setup-$version-windows-x64.exe\" }",
            "7z x $setup \"-o$tmp\" -y | Out-Null",
            "$plugins = Join-Path $tmp '$PLUGINSDIR'",
            "$app7z = Get-ChildItem -LiteralPath $plugins -Filter 'app-64.7z' -ErrorAction SilentlyContinue | Select-Object -First 1",
            "if (!$app7z) { $app7z = Get-ChildItem -LiteralPath $tmp -Filter 'app-64.7z' -Recurse -Force -ErrorAction SilentlyContinue | Select-Object -First 1 }",
            "if (!$app7z) { throw 'app-64.7z not found inside the installer' }",
            "7z x $app7z.FullName \"-o$dir\" -y | Out-Null",
            "Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue",
            "Get-ChildItem -LiteralPath $dir -Filter 'OMP-Studio-Setup-*.exe' -File -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "OMP Studio.exe",
            "omp-studio"
        ]
    ],
    "shortcuts": [
        [
            "OMP Studio.exe",
            "OMP Studio"
        ]
    ],
    "persist": [
        "dot-omp",
        "appdata-omp-studio"
    ],
    "pre_install": [
        "New-Item \"$persist_dir\\dot-omp\" -ItemType Directory -Force | Out-Null",
        "New-Item \"$persist_dir\\appdata-omp-studio\" -ItemType Directory -Force | Out-Null"
    ],
    "post_install": [
        "Remove-Item -LiteralPath (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $dir '$R0') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $dir '[NSIS].nsi') -Force -ErrorAction SilentlyContinue",

        "$omp = \"$env:USERPROFILE\\.omp\"",
        "$target = \"$persist_dir\\dot-omp\"",
        "New-Item $target -ItemType Directory -Force | Out-Null",
        "if (Test-Path $omp) {",
        "    $item = Get-Item $omp -Force",
        "    $isLink = [bool]($item.Attributes -band [IO.FileAttributes]::ReparsePoint)",
        "    if ($isLink) {",
        "        Write-Host '.omp is already a junction, skip'",
        "    } else {",
        "        Write-Host 'Migrating existing .omp -> scoop persist...'",
        "        Copy-Item \"$omp\\*\" $target -Recurse -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $omp -Recurse -Force",
        "        cmd /c \"mklink /J \\\"$omp\\\" \\\"$target\\\"\"",
        "    }",
        "} else {",
        "    cmd /c \"mklink /J \\\"$omp\\\" \\\"$target\\\"\"",
        "}",

        "$studio = \"$env:APPDATA\\omp-studio\"",
        "$studioTarget = \"$persist_dir\\appdata-omp-studio\"",
        "New-Item $studioTarget -ItemType Directory -Force | Out-Null",
        "if (Test-Path $studio) {",
        "    $item = Get-Item $studio -Force",
        "    $isLink = [bool]($item.Attributes -band [IO.FileAttributes]::ReparsePoint)",
        "    if ($isLink) {",
        "        Write-Host 'omp-studio AppData is already a junction, skip'",
        "    } else {",
        "        Write-Host 'Migrating existing omp-studio AppData -> scoop persist...'",
        "        Copy-Item \"$studio\\*\" $studioTarget -Recurse -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $studio -Recurse -Force",
        "        cmd /c \"mklink /J \\\"$studio\\\" \\\"$studioTarget\\\"\"",
        "    }",
        "} else {",
        "    cmd /c \"mklink /J \\\"$studio\\\" \\\"$studioTarget\\\"\"",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if (Test-Path \"$env:USERPROFILE\\.omp\") { cmd /c \"rmdir \\\"$env:USERPROFILE\\.omp\\\"\" }",
            "if (Test-Path \"$env:APPDATA\\omp-studio\") { cmd /c \"rmdir \\\"$env:APPDATA\\omp-studio\\\"\" }"
        ]
    },
    "checkver": {
        "github": "the-snowpear/omp-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/the-snowpear/omp-studio/releases/download/v$version/OMP-Studio-Setup-$version-windows-x64.exe"
            }
        }
    }
}
