{
    "version": "0.1.7",
    "description": "OMP Studio - Oh My Pi Studio",
    "homepage": "https://github.com/the-snowpear/omp-studio",
    "license": "MIT license",
    "depends": "7zip",

    "architecture": {
        "64bit": {
            "url": "https://github.com/the-snowpear/omp-studio/releases/download/v0.1.7/OMP-Studio-Setup-0.1.7-windows-x64.exe",
            "hash": ""
        }
    },

    "installer": {
        "script": [
            "$tmp = \"$dir\\tmp\"",
            "New-Item -ItemType Directory -Force -Path $tmp | Out-Null",
            "7z x \"$dir\\OMP-Studio-Setup-$version-windows-x64.exe\" -o$tmp -y",
            "7z x \"$tmp\\$PLUGINSDIR\\app-64.7z\" -o$dir -y",
            "Remove-Item $tmp -Recurse -Force",
            "Remove-Item \"$dir\\OMP-Studio-Setup-$version-windows-x64.exe\" -Force"
        ]
    },

    "bin": [
        [
            "OMP Studio.exe",
            "omp-studio"
        ]
    ],

    "shortcuts": [
        [
            "OMP Studio.exe",
            "OMP Studio"
        ]
    ],

    "checkver": {
        "github": "the-snowpear/omp-studio"
    },

    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/the-snowpear/omp-studio/releases/download/v$version/OMP-Studio-Setup-$version-windows-x64.exe"
            }
        }
    }
}
